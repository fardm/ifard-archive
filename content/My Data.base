formulas:
  starRating: |-
    if(rating == 5, "★★★★★",
    if(rating == 4.5, "★★★★⯨",
    if(rating == 4, "★★★★",
    if(rating == 3.5, "★★★⯨",
    if(rating == 3, "★★★",
    if(rating == 2.5, "★★⯨",
    if(rating == 2, "★★",
    if(rating == 1.5, "★⯨",
    if(rating == 1, "★",
    ""
    )))))))))
views:
  - type: cards
    name: All
    order:
      - file.name
      - badge
      - formula.starRating
    sort:
      - property: date
        direction: DESC
    image: note.cover
    cardSize: 170
    imageAspectRatio: 1.5
    imageFit: ""
  - type: cards
    name: 🎬 Movie
    filters:
      and:
        - file.hasTag("Movie")
    groupBy:
      property: type
      direction: ASC
    order:
      - file.name
      - badge
      - formula.starRating
    sort:
      - property: date
        direction: DESC
    image: note.cover
    cardSize: 170
    imageAspectRatio: 1.5
    imageFit: ""
  - type: cards
    name: 📚 Books
    filters:
      and:
        - file.hasTag("Book")
    order:
      - file.name
      - badge
      - pages
      - formula.starRating
    sort:
      - property: date
        direction: DESC
      - property: rating
        direction: DESC
    image: note.cover
    cardSize: 180
    imageAspectRatio: 1.5
    imageFit: ""
  - type: cards
    name: 🎙️ Podcast
    filters:
      and:
        - file.hasTag("Podcast")
    order:
      - file.name
      - badge
      - rating
    sort:
      - property: date
        direction: DESC
      - property: rating
        direction: DESC
    image: note.cover
    cardSize: 180
    imageAspectRatio: 1
    imageFit: ""
  - type: cards
    name: 🎓 Courses
    filters:
      and:
        - file.hasTag("Course")
    order:
      - file.name
      - rating
      - length
    sort:
      - property: date
        direction: DESC
      - property: rating
        direction: DESC
    image: note.cover
    cardSize: 200
    imageAspectRatio: 0.6
    imageFit: ""
  - type: cards
    name: ✨ Media
    filters:
      and:
        - file.hasTag("Media")
    order:
      - file.name
      - badge
      - rating
    sort:
      - property: date
        direction: DESC
      - property: rating
        direction: DESC
    image: note.cover
    cardSize: 180
    imageAspectRatio: 0.5
    imageFit: ""
  - type: cards
    name: 👤 Authors
    filters:
      and:
        - file.hasTag("Author")
    order:
      - file.name
    sort:
      - property: date
        direction: DESC
      - property: rating
        direction: DESC
    image: note.cover
    cardSize: 180
    imageAspectRatio: 1
    imageFit: ""
